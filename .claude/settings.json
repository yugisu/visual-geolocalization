{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Agent(Explore)",
      "Bash(grep*)",
      "Bash(tail*)",
      "Bash(uv *)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Read(**/diffusion-vpr/*)",
      "Read(**/diffusion-autoresearch/*)",
      "WebSearch",
      "WebFetch(domain:docs.marimo.io)"
    ],
    "ask": ["Bash(gh pr create:*)", "Bash(git commit:*)"],
    "deny": ["Read(*.env)", "Bash(rm:*)", "Bash(curl:*)"],
    "defaultMode": "default"
  },
  "includeCoAuthoredBy": false
}
