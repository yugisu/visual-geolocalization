{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Agent(Explore)",
      "Bash(grep*)",
      "Bash(tail*)",
      "Bash(uv *)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Read(**/diffusion-vpr/*)",
      "Read(**/diffusion-autoresearch/*)",
      "WebSearch",
      "WebFetch(domain:docs.marimo.io)",
      "Bash(python3)",
      "Read(//root/diffusion-autoresearch/**)"
    ],
    "deny": [
      "Read(*.env)",
      "Bash(rm:*)",
      "Bash(curl:*)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "/root/diffusion-autoresearch"
    ]
  }
}
